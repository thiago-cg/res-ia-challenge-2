# Retrieval path: fallback (dense + FTS) or target (9B + Qdrant)
RETRIEVAL_PATH=fallback

# Dense backend for RETRIEVAL_PATH=fallback: pgvector or qdrant
DENSE_BACKEND=pgvector

# Embedding provider: harrier (fallback), pplx (target) or openrouter
EMBEDDING_PROVIDER=harrier

# Pinned model revision (commit/tag). Must not be empty or "main".
# Not used by EMBEDDING_PROVIDER=openrouter.
EMBEDDING_MODEL_REVISION=

# LLM provider: mock, local, api or openrouter
LLM_PROVIDER=mock

# Local models / local LLM (optional)
PPX_9B_MODEL_PATH=
PPX_06B_MODEL_PATH=
HARRIER_MODEL_PATH=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# OpenRouter (chat + dense embeddings without local models).
# Use with RETRIEVAL_PATH=fallback: OpenRouter has no multivector/late model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1024
OPENROUTER_BATCH_SIZE=32
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Optional prefix applied only to queries (Qwen3 is instruction-aware).
OPENROUTER_QUERY_INSTRUCTION=

# Hard limits from the implementation plan
MAX_DEVICES=10
MAX_CONTEXT_TOKENS=6000
MAX_SUBQUESTIONS=3
MAX_AGENT_LOOPS=3

DATABASE_URL=postgresql://app:app@localhost:5432/violencia
QDRANT_URL=http://localhost:6333
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false
LOG_RETENTION_DAYS=7
