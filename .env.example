# Retrieval path: fallback (no GPU) or target (9B + Qdrant)
RETRIEVAL_PATH=fallback

# Embedding provider: harrier (fallback), pplx (target) or openrouter
EMBEDDING_PROVIDER=harrier

# Pinned model revision (commit/tag). Must not be empty or "main".
# Not used by EMBEDDING_PROVIDER=openrouter.
EMBEDDING_MODEL_REVISION=

# LLM provider: mock, local, api or openrouter
LLM_PROVIDER=mock

# OpenRouter (chat + dense embeddings without local models).
# Use with RETRIEVAL_PATH=fallback: OpenRouter has no multivector/late model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1024
OPENROUTER_BATCH_SIZE=32
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Hard limits from the implementation plan
MAX_DEVICES=10
MAX_CONTEXT_TOKENS=6000
MAX_SUBQUESTIONS=3
MAX_AGENT_LOOPS=3

# Local infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/violencia
QDRANT_URL=http://localhost:6333

# Model locations (safetensors directories, not GGUF)
PPX_9B_MODEL_PATH=
PPX_06B_MODEL_PATH=
HARRIER_MODEL_PATH=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LOG_LEVEL=INFO

# LGPD/observability: question text is never logged unless explicitly enabled.
# When enabled, PII is still redacted. File/DB sinks must honor retention.
LOG_QUESTION_TEXT=false
LOG_RETENTION_DAYS=7
