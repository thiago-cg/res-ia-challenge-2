# Retrieval path: fallback (no GPU) or target (9B + Qdrant)
RETRIEVAL_PATH=fallback

# Embedding provider: harrier (fallback) or pplx (target)
EMBEDDING_PROVIDER=harrier

# Pinned model revision (commit/tag). Must not be empty or "main".
EMBEDDING_MODEL_REVISION=

# LLM provider: mock, local or api
LLM_PROVIDER=mock

# Hard limits from the implementation plan
MAX_DEVICES=10
MAX_CONTEXT_TOKENS=6000
MAX_SUBQUESTIONS=3
MAX_AGENT_LOOPS=3

# Local infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/violencia
QDRANT_URL=http://localhost:6333

# Model locations (safetensors directories, not GGUF)
PPX_9B_MODEL_PATH=
PPX_06B_MODEL_PATH=
HARRIER_MODEL_PATH=
LLM_MODEL=
LOG_LEVEL=INFO

# LGPD/observability: question text is never logged unless explicitly enabled.
# When enabled, PII is still redacted. File/DB sinks must honor retention.
LOG_QUESTION_TEXT=false
LOG_RETENTION_DAYS=7
